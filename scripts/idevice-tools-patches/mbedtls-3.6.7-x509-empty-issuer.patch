--- a/library/x509_crt.c
+++ b/library/x509_crt.c
@@ -1188,7 +1188,11 @@
         return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);
     }
 
-    if ((ret = mbedtls_x509_get_name(&p, p + len, &crt->issuer)) != 0) {
+    /* Modified for suiteDFIR on 2026-09-26: parse the issuer only when it is not empty, as the
+     * subject below. The pairing certificates that libimobiledevice creates have empty issuer
+     * and subject names; without this the root certificate of a pair record does not parse, and
+     * every lockdown SSL session fails. */
+    if (len && (ret = mbedtls_x509_get_name(&p, p + len, &crt->issuer)) != 0) {
         mbedtls_x509_crt_free(crt);
         return ret;
     }
